    "ar": "سَيِّدُنَا عَلَمُ الْهُدَى",
    "tr": "Sayyidunā ʿAlamu l-hudā",
    "en": "Our master, standard of guidance"
  },
  "5:198": {
    "ar": "سَيِّدُنَا كَاشِفُ الْكُرَبِ",
    "tr": "Sayyidunā Kāshifu l-kurab",
    "en": "Our master, who lifts away distress"
  },
  "5:199": {
    "ar": "سَيِّدُنَا رَافِعُ الرُّتَبِ",
    "tr": "Sayyidunā Rāfiʿu r-rutab",
    "en": "Our master, who raises men in rank"
  },
  "5:200": {
    "ar": "سَيِّدُنَا عِزُّ الْعَرَبِ",
    "tr": "Sayyidunā ʿIzzu l-ʿarab",
    "en": "Our master, the honour of the Arabs"
  },
  "5:201": {
    "ar": "سَيِّدُنَا صَاحِبُ الْفَرَجِ",
    "tr": "Sayyidunā Ṣāḥibu l-faraj",
    "en": "Our master, bringer of relief"
  }
}
